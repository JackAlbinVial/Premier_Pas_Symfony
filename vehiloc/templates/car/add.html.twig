{% extends 'base.html.twig' %}

{% block title %} Ajouter une voiture - {{ parent() }}{% endblock %}

{% block body %}

<section id="add">
    <a href="{{ path('app_home') }}">← Retour</a>
    <h1>Ajouter une voiture</h1>

    {{ form_start(form) }}
        <div class="input">
            {{ form_row(form.Name) }}
        </div>
        <div class="input">
            {{ form_row(form.Description) }}
        </div>
        <div class="flex-input">
            <div class="input">
                {{ form_row(form.MonthPrice) }}
            </div>
            <div class="input">
                {{ form_row(form.DayPrice) }}
            </div>
        </div>
        <div class="flex-input">
            <div class="input">
                {{ form_row(form.Places) }}
            </div>
            <div class="input">
                {{ form_row(form.Gearbox) }}
            </div>
        </div>
        
        <button class="btn-add">Ajouter</button>
{{ form_end(form) }}
</section>

{% endblock %}